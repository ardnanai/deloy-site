{
  "name": "deloy-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "AIRTABLE_BASE_ID": "appJTHtkTGQbiuCpR",
    "AIRTABLE_TABLE_NAME": "Inbound Leads"
  }
}